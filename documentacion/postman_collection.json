{
  "info": {
    "name": "Sistema de Gestion de Logistica Portuaria",
    "description": "Coleccion de pruebas de los endpoints del API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Salud del Gateway",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "02 - Iniciar sesion",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 200) {",
            "  const data = pm.response.json();",
            "  if (data.token) {",
            "    pm.collectionVariables.set('token', data.token);",
            "    console.log('Token guardado correctamente');",
            "  }",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@puerto.com\",\n  \"password\": \"ESCRIBE_TU_CONTRASENA\"\n}"
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "03 - Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario de Prueba\",\n  \"correo\": \"prueba@puerto.com\",\n  \"password\": \"Prueba123\",\n  \"rol\": \"operador\"\n}"
        },
        "url": "{{baseUrl}}/api/usuarios"
      }
    },
    {
      "name": "04 - Consultar usuarios (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/usuarios"
      }
    },
    {
      "name": "05 - Consultar inventario",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/inventario"
      }
    },
    {
      "name": "06 - Agregar recurso (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Contenedor de prueba\",\n  \"cantidad\": 10,\n  \"categoria\": \"Contenedores\",\n  \"estado\": \"Disponible\"\n}"
        },
        "url": "{{baseUrl}}/api/inventario"
      }
    },
    {
      "name": "07 - Consultar operaciones",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/operaciones"
      }
    },
    {
      "name": "08 - Registrar operacion",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"Entrada\",\n  \"buque\": \"Buque de prueba\",\n  \"contenedores\": 5,\n  \"estado\": \"Programada\"\n}"
        },
        "url": "{{baseUrl}}/api/operaciones"
      }
    },
    {
      "name": "09 - Registrar liberacion aduanera",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contenedor\": \"CONT-001\",\n  \"agente_aduanal\": \"Agente de prueba\",\n  \"estado\": \"Pendiente\",\n  \"observaciones\": \"Prueba de Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/liberaciones"
      }
    },
    {
      "name": "10 - Consultar liberaciones",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/liberaciones"
      }
    }
  ]
}
